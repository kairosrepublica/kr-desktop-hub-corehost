
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="KrWidgetBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="KrWidgetSurfaceBrush" Color="#FFF5F7FA" />
    <SolidColorBrush x:Key="KrWidgetBorderBrush" Color="#FFD8DEE7" />
    <SolidColorBrush x:Key="KrWidgetTextBrush" Color="#FF18212B" />
    <SolidColorBrush x:Key="KrWidgetMutedTextBrush" Color="#FF647180" />
    <SolidColorBrush x:Key="KrWidgetQuietTextBrush" Color="#FF8793A1" />
    <SolidColorBrush x:Key="KrWidgetOpenBrush" Color="#FF168647" />
    <SolidColorBrush x:Key="KrWidgetCurrentTimeBrush" Color="#FFCC7A18" />
    <SolidColorBrush x:Key="KrWidgetDangerBrush" Color="#FFB54747" />

    <Thickness x:Key="KrWidgetOuterPadding">10</Thickness>
    <Thickness x:Key="KrWidgetInnerPadding">8</Thickness>
    <CornerRadius x:Key="KrWidgetCornerRadius">10</CornerRadius>

    <Style x:Key="KrWidgetSurfaceBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource KrWidgetBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KrWidgetBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KrWidgetCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource KrWidgetInnerPadding}" />
    </Style>

    <Style x:Key="KrWidgetHeaderTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource KrWidgetTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="KrWidgetSecondaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource KrWidgetMutedTextBrush}" />
        <Setter Property="FontSize" Value="10" />
    </Style>
</ResourceDictionary>
