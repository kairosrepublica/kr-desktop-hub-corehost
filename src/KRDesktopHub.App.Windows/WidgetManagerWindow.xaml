<Window
    x:Class="KRDesktopHub.App.Windows.WidgetManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KR Desktop Hub - Widget Manager"
    Width="760"
    Height="620"
    MinWidth="680"
    MinHeight="540"
    WindowStartupLocation="CenterOwner">
    <Grid
        x:Name="ManagerRoot"
        Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="Internal Widget Manager" />
            <TextBlock
                Margin="0,6,0,0"
                TextWrapping="Wrap"
                Text="Owner-approved packages remain inert until you explicitly choose Install. Production packages must use the .krwidget.zip extension." />
        </StackPanel>

        <WrapPanel
            Grid.Row="1"
            Margin="0,16,0,12">
            <Button
                Margin="0,0,8,8"
                Padding="10,6"
                Click="RefreshInboxButton_Click"
                Content="Refresh Inbox" />
            <Button
                Margin="0,0,8,8"
                Padding="10,6"
                Click="BrowseArchiveButton_Click"
                Content="Choose Package File" />
            <Button
                Margin="0,0,8,8"
                Padding="10,6"
                Click="OpenPluginsFolderButton_Click"
                Content="Open Plugins Folder" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                FontWeight="SemiBold"
                Text="Discovered packages in plugins/inbox" />

            <ListBox
                x:Name="InboxListBox"
                Grid.Row="1"
                Margin="0,8,0,10"
                DisplayMemberPath="DisplayText" />

            <Button
                Grid.Row="2"
                HorizontalAlignment="Left"
                Padding="10,6"
                Click="InstallInboxSelectionButton_Click"
                Content="Install Selected Inbox Package" />

            <StackPanel
                Grid.Row="3"
                Margin="0,16,0,0">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Selected package file" />
                <TextBox
                    x:Name="SelectedArchivePathTextBox"
                    Margin="0,6,0,8"
                    IsReadOnly="True"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Left"
                    Padding="10,6"
                    Click="InstallSelectedArchiveButton_Click"
                    Content="Install Chosen Package File" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Padding="10"
            BorderBrush="Gray"
            BorderThickness="1">
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Advanced development-only install" />
                <CheckBox
                    x:Name="EnableDevelopmentFolderInstallCheckBox"
                    Margin="0,8,0,8"
                    Content="Temporarily enable folder install for this explicit action" />
                <Button
                    HorizontalAlignment="Left"
                    Padding="10,6"
                    Click="InstallDevelopmentFolderButton_Click"
                    Content="Choose and Install Development Folder" />
            </StackPanel>
        </Border>

        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="4"
            Margin="0,16,0,0"
            TextWrapping="Wrap"
            Text="Ready. Refresh the inbox or choose a .krwidget.zip file." />
    </Grid>
</Window>