<Window
    x:Class="KRDesktopHub.App.Windows.SettingsCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KR Desktop Hub - Settings Center"
    Width="900"
    Height="760"
    MinWidth="760"
    MinHeight="620"
    WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="CoreHost Settings Center" />
            <TextBlock
                Margin="0,6,0,0"
                TextWrapping="Wrap"
                Text="Each setting shows its recommended default, recommendation reason and application mode. Settings are saved durably under the CoreHost data root." />
            <WrapPanel Margin="0,16,0,12">
                <Button
                    Margin="0,0,8,8"
                    Padding="10,6"
                    Click="SaveButton_Click"
                    Content="Save Settings" />
                <Button
                    Margin="0,0,8,8"
                    Padding="10,6"
                    Click="ReloadButton_Click"
                    Content="Reload Settings" />
                <Button
                    Margin="0,0,8,8"
                    Padding="10,6"
                    Click="OpenSettingsFolderButton_Click"
                    Content="Open Settings Folder" />
            </WrapPanel>
            <TextBlock
                x:Name="StatusTextBlock"
                Margin="0,0,0,12"
                TextWrapping="Wrap"
                Text="Ready." />
        </StackPanel>
        <ScrollViewer
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SectionsPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>